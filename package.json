{
  "name": "@uelabs/odata-drizzle",
  "version": "1.0.4",
  "type": "module",
  "description": "Convert OData v4 AST to Drizzle ORM queries",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "yarn build",
    "build": "tsup",
    "build:tsc": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "odata",
    "drizzle",
    "orm",
    "query",
    "parser"
  ],
  "author": {
    "name": "Bo Motlagh",
    "email": "hello@uelabs.ai",
    "url": "https://uelabs.ai"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/unitedeffectslabs/odata.v4.drizzle.git"
  },
  "bugs": {
    "url": "https://github.com/unitedeffectslabs/odata.v4.drizzle/issues"
  },
  "homepage": "https://github.com/unitedeffectslabs/odata.v4.drizzle#readme",
  "packageManager": "yarn@4.9.4",
  "dependencies": {
    "@uev/odata-parser": "^0.2.1"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-orm": "^0.45.2",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  }
}
